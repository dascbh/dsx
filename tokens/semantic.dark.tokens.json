{
  "$description": "Camada 2 — semânticos (tema escuro). Mesmas chaves do tema claro; só os valores mudam. Chaves ausentes herdam do claro.",
  "color": {
    "bg": {
      "canvas":  { "$type": "color", "$value": "{color.neutral.950}" },
      "surface": { "$type": "color", "$value": "{color.neutral.900}" },
      "sunken":  { "$type": "color", "$value": "#16191d" },
      "overlay": { "$type": "color", "$value": "#000000b3" },
      "inverse": { "$type": "color", "$value": "{color.neutral.50}" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "{color.neutral.50}" },
      "secondary": { "$type": "color", "$value": "{color.neutral.200}" },
      "muted":     { "$type": "color", "$value": "{color.neutral.300}" },
      "inverse":   { "$type": "color", "$value": "{color.neutral.950}" },
      "link":      { "$type": "color", "$value": "{color.brand.300}" },
      "on-action": { "$type": "color", "$value": "{color.neutral.950}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.neutral.800}" },
      "strong":  { "$type": "color", "$value": "{color.neutral.500}" },
      "focus":   { "$type": "color", "$value": "{color.brand.300}" }
    },
    "action": {
      "primary":         { "$type": "color", "$value": "{color.brand.300}" },
      "primary-hover":   { "$type": "color", "$value": "{color.brand.200}" },
      "primary-active":  { "$type": "color", "$value": "{color.brand.400}" },
      "secondary":       { "$type": "color", "$value": "{color.neutral.800}" },
      "secondary-hover": { "$type": "color", "$value": "{color.neutral.700}" },
      "danger":          { "$type": "color", "$value": "{color.danger.400}" },
      "danger-hover":    { "$type": "color", "$value": "{color.danger.300}" },
      "disabled":        { "$type": "color", "$value": "{color.neutral.800}" },
      "disabled-text":   { "$type": "color", "$value": "{color.neutral.500}" }
    },
    "feedback": {
      "success-bg":   { "$type": "color", "$value": "{color.success.950}" },
      "success-text": { "$type": "color", "$value": "{color.success.200}" },
      "success-icon": { "$type": "color", "$value": "{color.success.400}" },
      "danger-bg":    { "$type": "color", "$value": "{color.danger.950}" },
      "danger-text":  { "$type": "color", "$value": "{color.danger.200}" },
      "danger-icon":  { "$type": "color", "$value": "{color.danger.400}" },
      "warning-bg":   { "$type": "color", "$value": "{color.warning.950}" },
      "warning-text": { "$type": "color", "$value": "{color.warning.200}" },
      "warning-icon": { "$type": "color", "$value": "{color.warning.400}" },
      "info-bg":      { "$type": "color", "$value": "{color.info.950}" },
      "info-text":    { "$type": "color", "$value": "{color.info.200}" },
      "info-icon":    { "$type": "color", "$value": "{color.info.400}" }
    },
    "ai": {
      "accent":  { "$type": "color", "$value": "{color.brand.300}" },
      "surface": { "$type": "color", "$value": "{color.brand.950}" }
    }
  }
}
